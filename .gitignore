# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# 비밀 값
.env
.env.*
!.env.example

# 데이터: 폴더 구조와 README만 올린다 (뉴스는 재배포 금지, 가격은 스크립트로 다시 받음)
data/**
!data/**/
!data/**/.gitkeep
!data/README.md

# 실험 산출물: runs/는 올리지 않고, serving/은 올린다 (clone 후 바로 실행되도록)
artifacts/runs/*
!artifacts/runs/.gitkeep

# 노트북·편집기·OS
.ipynb_checkpoints/
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
