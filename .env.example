# .env로 복사한 뒤 값을 채운다. .env는 Git에 올리지 않는다.
#   cp .env.example .env

# LLM (D) — OpenAI를 쓸 경우
OPENAI_API_KEY=

# DART 공시 API (D·A) — A는 배당 공시 대조(data/dart.py)에도 같은 키를 쓴다
DART_API_KEY=

# KRX 로그인 (A) — pykrx가 자동으로 읽는다. 없으면 근사치로 떨어진다 (src/roboadvisor/data/sources.py)
KRX_ID=
KRX_PW=

# DB 주소 (E) — 비워 두면 data/app/app.db (SQLite)
DATABASE_URL=
